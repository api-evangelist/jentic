  "info": {
    "_postman_id": "ba663906-e852-48e0-a067-c7dd712e75e6",
    "name": "Jentic Authentication API",
    "description": "The Jentic API is the hosted agent control plane that lets any AI agent dynamically discover, load, and execute API operations and Arazzo workflows from the Jentic catalog. The canonical flow is search \u2192 load \u2192 execute. Operation UUIDs are prefixed `op_` and workflow UUIDs are prefixed `wf_`. Authentication uses an agent-scoped API key (`X-JENTIC-API-KEY`). Credentials for upstream APIs are injected server-side at execution time and are never exposed to the agent.\n\nContact Support:\n Name: Jentic Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T01:59:39.000Z",
    "updatedAt": "2026-07-28T01:59:39.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-ba663906-e852-48e0-a067-c7dd712e75e6"
  },
