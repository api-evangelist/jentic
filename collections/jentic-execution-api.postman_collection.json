          "name": "Load Execution Information For Operations",
          "request": {
            "name": "Load Execution Information For Operations",
            "description": {
              "content": "Retrieves the full execution specification for one or more API operations or Arazzo workflows from the Jentic catalog. Returns HTTP method, path, input JSON Schema, authentication requirements, and other metadata needed to call the operation. Use the UUIDs returned from the search endpoint.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "agents",
                "load"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
